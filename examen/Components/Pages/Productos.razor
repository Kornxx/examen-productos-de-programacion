@page "/Productos"
@rendermode InteractiveServer

<PageTitle>Productos</PageTitle>

<h1>Productos</h1>

@if (!string.IsNullOrWhiteSpace(mensajeError))
{
    <div class="alert alert-danger" role="alert">@mensajeError</div>
}

<div class="row mb-3">
    <label class="col-sm-2 col-form-label">Inventario</label>
    <div class="col-sm-10">
        <input type="number" class="form-control" @bind="inventario" />
    </div>
</div>

<div class="row mb-3">
    <label class="col-sm-2 col-form-label">Nombre</label>
    <div class="col-sm-10">
        <input type="text" class="form-control" @bind="nombre" />
    </div>
</div>

<div class="row mb-3">
    <label class="col-sm-2 col-form-label">Departamento</label>
    <div class="col-sm-10 pt-2">
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="depto" id="rFrutas"
                   checked="@(departamento == "Frutas")" @onchange="SeleccionarFrutas" />
            <label class="form-check-label" for="rFrutas">Frutas</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="depto" id="rVerduras"
                   checked="@(departamento == "Verduras")" @onchange="SeleccionarVerduras" />
            <label class="form-check-label" for="rVerduras">Verduras</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="depto" id="rLacteos"
                   checked="@(departamento == "Lácteos")" @onchange="SeleccionarLacteos" />
            <label class="form-check-label" for="rLacteos">Lácteos</label>
        </div>
    </div>
</div>

<div class="mb-3">
    @if (indiceEdicion == -1)
    {
        <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
    }
    else
    {
        <button class="btn btn-primary" @onclick="Actualizar">Actualizar</button>
        <button class="btn btn-danger" @onclick="Cancelar">Cancelar</button>
    }
</div>

<div class="mb-3">
    @if (verExistencias)
    {
        <button class="btn btn-secondary" @onclick="MostrarListado">Listado</button>
    }
    else
    {
        <button class="btn btn-secondary" @onclick="MostrarExistencias">Existencias</button>
    }
</div>

@if (verExistencias)
{
    <p class="text-muted mb-1">Existencias por departamento</p>
    <table class="table">
        <thead>
            <tr>
                <th>Frutas</th>
                <th>Verduras</th>
                <th>Lácteos</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@totalFrutas</td>
                <td>@totalVerduras</td>
                <td>@totalLacteos</td>
            </tr>
        </tbody>
    </table>
}
else
{
    <p class="text-muted mb-1">Listado de productos</p>
    <table class="table">
        <thead>
            <tr>
                <th>Inventario</th>
                <th>Nombre</th>
                <th>Departamento</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < inventarios.Count; i++)
            {
                int indice = i;
                <tr>
                    <td>@inventarios[i]</td>
                    <td>@nombres[i]</td>
                    <td>@departamentos[i]</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger me-2" @onclick="() => Eliminar(indice)">Eliminar</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Editar(indice)">Editar</button>
                        </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // Datos del formulario
    int inventario = 0;
    string nombre = "";
    string departamento = "";

    // "Base de datos" en memoria (listas paralelas: misma posición = mismo producto)
    List<int> inventarios = new List<int>();
    List<string> nombres = new List<string>();
    List<string> departamentos = new List<string>();

    // Control de la pantalla
    string mensajeError = "";
    int indiceEdicion = -1;       // -1 = no se está editando
    bool verExistencias = false;

    // Totales de la vista de existencias
    int totalFrutas = 0;
    int totalVerduras = 0;
    int totalLacteos = 0;

    void SeleccionarFrutas()
    {
        departamento = "Frutas";
    }

    void SeleccionarVerduras()
    {
        departamento = "Verduras";
    }

    void SeleccionarLacteos()
    {
        departamento = "Lácteos";
    }

    // Revisa que los datos del formulario sean correctos.
    // Devuelve true si todo está bien; si no, deja el mensaje en mensajeError.
    bool DatosValidos()
    {
        if (inventario <= 0)
        {
            mensajeError = "El número de inventario debe ser un entero positivo.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(nombre))
        {
            mensajeError = "El nombre no puede estar vacío.";
            return false;
        }

        if (departamento == "")
        {
            mensajeError = "Debe seleccionar un departamento.";
            return false;
        }

        // Inventario repetido (se ignora la posición que se está editando)
        for (int i = 0; i < inventarios.Count; i++)
        {
            if (inventarios[i] == inventario && i != indiceEdicion)
            {
                mensajeError = "El número de inventario se encuentra registrado. Debe ser único.";
                return false;
            }
        }

        mensajeError = "";
        return true;
    }

    void LimpiarFormulario()
    {
        inventario = 0;
        nombre = "";
        departamento = "";
        indiceEdicion = -1;
    }

    void Guardar()
    {
        if (DatosValidos())
        {
            inventarios.Add(inventario);
            nombres.Add(nombre.Trim());
            departamentos.Add(departamento);
            LimpiarFormulario();
        }
    }

    void Eliminar(int indice)
    {
        inventarios.RemoveAt(indice);
        nombres.RemoveAt(indice);
        departamentos.RemoveAt(indice);

        // Si se estaba editando algún producto, se cancela para no perder la posición
        if (indiceEdicion != -1)
        {
            Cancelar();
        }
    }

    void Editar(int indice)
    {
        indiceEdicion = indice;
        inventario = inventarios[indice];
        nombre = nombres[indice];
        departamento = departamentos[indice];
        mensajeError = "";
    }

    void Actualizar()
    {
        if (DatosValidos())
        {
            inventarios[indiceEdicion] = inventario;
            nombres[indiceEdicion] = nombre.Trim();
            departamentos[indiceEdicion] = departamento;
            LimpiarFormulario();
        }
    }

    void Cancelar()
    {
        mensajeError = "";
        LimpiarFormulario();
    }

    void ContarExistencias()
    {
        totalFrutas = 0;
        totalVerduras = 0;
        totalLacteos = 0;

        foreach (string d in departamentos)
        {
            switch (d)
            {
                case "Frutas":
                    totalFrutas++;
                    break;
                case "Verduras":
                    totalVerduras++;
                    break;
                case "Lácteos":
                    totalLacteos++;
                    break;
            }
        }
    }

    void MostrarExistencias()
    {
        ContarExistencias();
        verExistencias = true;
    }

    void MostrarListado()
    {
        verExistencias = false;
    }
}
